    "/api/v1/fares/quote": {
      "get": {
        "tags": ["Fare"],
        "summary": "구간 운임 시세 조회 (DB 캐시 우선, miss 시 AI 추정)",
        "operationId": "quote",
        "parameters": [
          {
            "name": "originSido",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destSido",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cargoType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["REFRIGERATED", "GENERAL", "FROZEN", "CONSTRUCTION", "HAZARDOUS"]
            }
          },
          {
            "name": "weightTon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "desiredFare",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseFareQuoteResponse"
                }
              }
            }
          }
        }
      }
    },
