    "/api/v1/loads": {
      "get": {
        "tags": ["Load"],
        "summary": "기사 구간 기준 매칭 점수순 화물 목록",
        "operationId": "getLoads",
        "parameters": [
          {
            "name": "driverId",
            "in": "query",
