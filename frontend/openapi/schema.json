    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "API 상태 확인",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ShipperProfileRequest": {
        "type": "object",
        "properties": {
          "companyName": { "type": "string", "maxLength": 100, "minLength": 0 },
          "contactName": { "type": "string", "maxLength": 50, "minLength": 0 },
          "phoneNumber": { "type": "string", "maxLength": 20, "minLength": 0 },
          "businessNumber": { "type": "string", "maxLength": 20, "minLength": 0 },
          "address": { "type": "string", "maxLength": 200, "minLength": 0 }
        },
        "required": ["companyName", "contactName", "phoneNumber"]
      },
      "ApiResponseShipperProfileResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/ShipperProfileResponse" },
          "message": { "type": "string" }
        }
      },
      "ShipperProfileResponse": {
        "type": "object",
        "properties": {
          "shipperId": { "type": "integer", "format": "int64" },
          "companyName": { "type": "string" },
          "contactName": { "type": "string" },
          "phoneNumber": { "type": "string" },
          "businessNumber": { "type": "string" },
          "address": { "type": "string" }
        }
      },
      "DriverProfileRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 50, "minLength": 0 },
          "phoneNumber": { "type": "string", "maxLength": 20, "minLength": 0 },
          "plateNumber": { "type": "string", "maxLength": 20, "minLength": 0 },
          "vehicleType": { "type": "string", "maxLength": 20, "minLength": 0 },
          "capacityTon": { "type": "number", "minimum": 0.1 },
          "bodyType": { "type": "string", "maxLength": 20, "minLength": 0 },
          "vehicleCargoTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "REFRIGERATED|GENERAL|FROZEN|CONSTRUCTION|HAZARDOUS"
            },
            "maxItems": 5,
            "minItems": 0
          },
          "minAcceptFare": { "type": "integer", "format": "int32" },
          "contactableFrom": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?:[01]\\d|2[0-3]):[0-5]\\d"
          },
          "contactableTo": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?:[01]\\d|2[0-3]):[0-5]\\d"
          }
        },
        "required": [
          "bodyType",
          "capacityTon",
          "contactableFrom",
          "contactableTo",
          "minAcceptFare",
          "name",
          "phoneNumber",
          "plateNumber",
          "vehicleCargoTypes",
          "vehicleType"
        ]
      },
      "ApiResponseDriverResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/DriverResponse" },
          "message": { "type": "string" }
        }
      },
      "DriverResponse": {
        "type": "object",
        "properties": {
          "driverId": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "phoneNumber": { "type": "string" },
          "plateNumber": { "type": "string" },
          "vehicleType": { "type": "string" },
          "capacityTon": { "type": "number" },
          "bodyType": { "type": "string" },
          "vehicleCargoTypes": { "type": "array", "items": { "type": "string" } },
          "rating": { "type": "number" },
          "totalTrips": { "type": "integer", "format": "int32" },
          "completionRate": { "type": "integer", "format": "int32" },
          "minAcceptFare": { "type": "integer", "format": "int32" },
          "contactableFrom": { "type": "string" },
          "contactableTo": { "type": "string" },
          "recentTripSummary": { "type": "string" },
          "routePreferences": { "$ref": "#/components/schemas/RoutePreferences" }
        }
      },
      "RegionPoint": {
        "type": "object",
        "properties": { "sido": { "type": "string" }, "sigungu": { "type": "string" } }
      },
      "RoutePreferences": {
        "type": "object",
        "properties": {
          "origins": { "type": "array", "items": { "$ref": "#/components/schemas/RegionPoint" } },
          "destinations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RegionPoint" }
          }
        }
      },
      "RoutePreferenceRequest": {
        "type": "object",
        "properties": {
          "origins": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RegionPoint" },
            "minItems": 1
          },
          "destinations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RegionPoint" },
            "minItems": 1
          }
        },
        "required": ["destinations", "origins"]
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {},
          "message": { "type": "string" }
        }
      },
      "ApiResponseCompleteResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/CompleteResponse" },
          "message": { "type": "string" }
        }
      },
      "CompleteResponse": {
        "type": "object",
        "properties": {
          "assignmentId": { "type": "integer", "format": "int64" },
          "cargoId": { "type": "integer", "format": "int64" },
          "status": { "type": "string" },
          "completedAt": { "type": "string", "format": "date-time" },
          "nextLoadRecommendation": {
            "$ref": "#/components/schemas/NextLoadRecommendationResponse"
          }
        }
      },
      "NextLoadRecommendationResponse": {
        "type": "object",
        "properties": {
          "cargoId": { "type": "integer", "format": "int64" },
          "origin": { "type": "string" },
          "destination": { "type": "string" },
          "loadingAt": { "type": "string", "format": "date-time" },
          "unloadingAt": { "type": "string", "format": "date-time" },
          "cargoType": { "type": "string" },
          "weightTon": { "type": "number" },
          "fare": { "type": "integer", "format": "int32" },
          "emptyDistanceKm": { "type": "number", "format": "double" },
          "waitMinutes": { "type": "integer", "format": "int64" },
          "connectionScore": { "type": "integer", "format": "int32" },
          "recommendationSummary": { "type": "string" },
          "recommendationReasons": { "type": "array", "items": { "type": "string" } },
          "explanationMode": { "type": "string" }
        }
      },
      "AcceptResponse": {
        "type": "object",
        "properties": {
          "assignmentId": { "type": "integer", "format": "int64" },
          "cargoId": { "type": "integer", "format": "int64" },
          "status": { "type": "string" }
        }
      },
      "ApiResponseAcceptResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/AcceptResponse" },
          "message": { "type": "string" }
        }
      },
      "CargoCreateRequest": {
        "type": "object",
        "properties": {
          "origin": { "$ref": "#/components/schemas/CargoRegionPoint" },
          "destination": { "$ref": "#/components/schemas/CargoRegionPoint" },
          "cargoType": {
            "type": "string",
            "enum": ["REFRIGERATED", "GENERAL", "FROZEN", "CONSTRUCTION", "HAZARDOUS"]
          },
          "cargoDescription": { "type": "string" },
          "weightTon": { "type": "number" },
          "vehicleType": { "type": "string" },
          "bodyType": { "type": "string" },
          "desiredFare": { "type": "integer", "format": "int32" },
          "loadingAt": { "type": "string", "format": "date-time" },
          "unloadingAt": { "type": "string", "format": "date-time" },
          "distanceKm": { "type": "integer", "format": "int32" }
        },
        "required": [
          "cargoType",
          "desiredFare",
          "destination",
          "loadingAt",
          "origin",
          "unloadingAt",
          "weightTon"
        ]
      },
      "CargoRegionPoint": {
        "type": "object",
        "properties": {
          "sido": { "type": "string", "minLength": 1 },
          "sigungu": { "type": "string", "minLength": 1 }
        },
        "required": ["sido", "sigungu"]
      },
      "ApiResponseMapStringObject": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object", "additionalProperties": {} },
          "message": { "type": "string" }
        }
      },
      "ParseRequest": {
        "type": "object",
        "properties": {
          "requestText": { "type": "string", "minLength": 1 },
