    "/api/v1/loads": {
      "get": {
        "tags": ["Load"],
        "summary": "기사 화물 목록 조회 (10건 커서 페이지네이션)",
        "operationId": "getLoads",
        "parameters": [
          {
            "name": "driverId",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "ALL", "enum": ["ALL", "ACCEPTED", "HIDDEN"] }
          },
          {
            "name": "preferenceText",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false }
          },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCursorPageResponseLoadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/loads/completed": {
      "get": {
        "tags": ["Load"],
