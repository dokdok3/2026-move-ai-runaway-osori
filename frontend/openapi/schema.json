  "paths": {
    "/api/v1/drivers/me/route-preferences": {
      "put": {
        "tags": ["Driver"],
        "summary": "다니는 구간 전체 교체 저장",
        "operationId": "updateRoutePreferences",
        "parameters": [
          {
            "name": "driverId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoutePreferenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDriverResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/loads/{cargoId}/accept": {
      "post": {
        "tags": ["Load"],
        "summary": "화물 수락",
        "operationId": "accept",
